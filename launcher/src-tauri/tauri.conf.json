{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dual Pulse Launcher",
  "version": "0.2.0",
  "identifier": "studio.dualpulse.launcher",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Dual Pulse Launcher", "width": 1180, "height": 740, "minWidth": 980, "minHeight": 620, "decorations": false, "center": true, "resizable": true }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; media-src 'self' https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser", "displayLanguageSelector": false, "languages": ["English"] } }
  }
}
