<?xml version="1.0" encoding="utf-8"?>
<!-- Réseau local : HTTPS avec le certificat de votre PC (épinglé dans l'application) ; HTTP autorisé pour le relais de réveil. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
