{
  "$schema": "https://railway.app/railway.schema.json",
  "build": { "builder": "NIXPACKS", "buildCommand": "cd dualpulse_site && pip install -r requirements.txt" },
  "deploy": { "startCommand": "cd dualpulse_site && uvicorn app.main:app --host 0.0.0.0 --port $PORT --proxy-headers --forwarded-allow-ips '*'", "healthcheckPath": "/healthz", "restartPolicyType": "ON_FAILURE" }
}
