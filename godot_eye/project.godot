; Œil d'E.N.O.S. : widget de bureau (Desktop Pet). Fenêtre sans bordure, fond transparent, toujours au premier plan.
config_version=5

[application]
config/name="ENOS Eye"
run/main_scene="res://main.tscn"
run/max_fps=60
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 0)

[display]
window/size/viewport_width=360
window/size/viewport_height=460
window/size/borderless=true
window/size/always_on_top=true
window/size/transparent=true
window/size/resizable=false
window/per_pixel_transparency/allowed=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
viewport/transparent_background=true
environment/defaults/default_clear_color=Color(0, 0, 0, 0)

