# Dual Pulse — variables d'environnement (Render / Railway : onglet « Environment »). Ne JAMAIS committer le vrai fichier.
DP_ADMIN_TOKEN=            # long secret aléatoire (32+ caractères) : création du CEO, publication des versions
DP_ADMIN_PATH=admin-dp
DP_DATABASE_URL=           # Supabase > Project Settings > Database > Connection string > « Transaction pooler » (port 6543) — l'hébergeur gratuit n'a pas de disque durable
DP_TOKEN_KEY=              # clé privée Ed25519 des jetons (base64) : py -c "from app.launcher import tokens as t; print(t.private_to_b64(t.new_private()))"
DP_MANIFEST_PUBKEY=        # contenu de ota_pubkey.txt (clé publique de signature des manifestes)
DP_REQUIRE_CEO_TOTP=1
DP_R2_ENDPOINT=            # https://<ID_COMPTE>.r2.cloudflarestorage.com
DP_R2_BUCKET=
DP_R2_ACCESS_KEY=
DP_R2_SECRET_KEY=
DP_TRUSTED_PROXIES=        # plages des proxys de l'hébergeur, pour lire la vraie IP des visiteurs (voir docs)
DP_LAUNCHER_ORIGINS=       # origines supplémentaires autorisées (CORS), séparées par des virgules
